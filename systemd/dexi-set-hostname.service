[Unit]
Description=Set DEXI hostname from wlan0 MAC on first boot
ConditionPathExists=!/var/lib/dexi/hostname-set
DefaultDependencies=no
After=local-fs.target sys-subsystem-net-devices-wlan0.device
Before=NetworkManager.service network-pre.target
Wants=sys-subsystem-net-devices-wlan0.device

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dexi/set_hostname.sh
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
